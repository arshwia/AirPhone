#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG_FILE="$HOME/.config/airphone/config.conf"
readonly ICON="$HOME/.local/share/icons/airphone.png"

# Default values
PHONE_IP="${PHONE_IP:-}"
PHONE_PORT="${PHONE_PORT:-5555}"
SCRCPY_ARGS="${SCRCPY_ARGS:---turn-screen-off --stay-awake --power-off-on-close}"

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
}

save_config() {
    mkdir -p "$(dirname "$CONFIG_FILE")"
    cat > "$CONFIG_FILE" <<EOF
# AirPhone Configuration
PHONE_IP="$PHONE_IP"
PHONE_PORT="$PHONE_PORT"
SCRCPY_ARGS="$SCRCPY_ARGS"
EOF
}

connect_phone() {
    adb disconnect "${PHONE_IP}:${PHONE_PORT}" >/dev/null 2>&1 || true
    adb connect "${PHONE_IP}:${PHONE_PORT}" >/dev/null 2>&1 || true

    if adb devices | grep -q "${PHONE_IP}:${PHONE_PORT}.*device"; then
        return 0
    fi
    return 1
}

ask_for_connection_data() {
    local new_ip new_port

    new_ip=$(zenity --entry \
        --title="AirPhone" \
        --text="Enter phone IP address:" \
        --entry-text="${PHONE_IP:-}")
    
    new_port=$(zenity --entry \
        --title="AirPhone" \
        --text="Enter phone port:" \
        --entry-text="${PHONE_PORT:-5555}")

    if [[ -n "$new_ip" && -n "$new_port" ]]; then
        PHONE_IP="$new_ip"
        PHONE_PORT="$new_port"
        save_config
        notify-send "AirPhone" "Settings saved." --icon="$ICON"
    else
        notify-send "AirPhone" "Operation cancelled." --icon="$ICON"
        exit 1
    fi
}

start_scrcpy() {
    notify-send "AirPhone" "Connecting to phone..." --icon="$ICON"
    exec scrcpy -e ${SCRCPY_ARGS}
}

main() {
    load_config

    if ! command -v adb >/dev/null; then
        notify-send "AirPhone" "adb not found. Please install Android Platform Tools." --icon="$ICON"
        exit 1
    fi
    if ! command -v scrcpy >/dev/null; then
        notify-send "AirPhone" "scrcpy not found." --icon="$ICON"
        exit 1
    fi

    if ! connect_phone; then
        notify-send "AirPhone" "Automatic connection failed.\nOpening setup dialog..." --icon="$ICON"
        ask_for_connection_data
        if ! connect_phone; then
            notify-send "AirPhone" "Connection failed.\nPlease check USB Debugging and Wireless Debugging." --icon="$ICON"
            exit 1
        fi
    fi

    start_scrcpy
}

main "$@"